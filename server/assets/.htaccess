# Vite fingerprints these filenames. A new build gets a new URL.
# This policy applies only to /assets, never HTML, API responses or account data.
<IfModule mod_headers.c>
<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|otf|svg|png|jpe?g|webp|avif|gif|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
</FilesMatch>
</IfModule>
