DirectoryIndex index.html index.php
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteCond %{HTTP_HOST} ^(www\.)?mangamukai\.com(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mangamukai\.com [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://mangamukai.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^(src|node_modules|\.vscode)(/|$) - [F,L]
RewriteRule (^|/)(error_log|debug_auth\.log|\.env|package(-lock)?\.json|tsconfig[^/]*\.json|vite\.config\.ts)$ - [NC,F,L]
RewriteRule \.(log|bak|save|tmp|orig|sql)(\.|-|$) - [NC,F,L]
RewriteRule \.(php|js|css)\.(bak|before|codex)[^/]*$ - [NC,F,L]
RewriteRule (^|/)[^/]+\.before-[^/]*$ - [NC,F,L]
RewriteRule ^mangamukai-[^/]*\.zip$ - [NC,F,L]
RewriteCond %{QUERY_STRING} (^|&)mm_(coin|sub)_ipn=1(&|$)
RewriteRule ^$ /index.php [L]
RewriteCond %{QUERY_STRING} (^|&)(provider|return_provider)=(google|discord)(&|$) [NC]
RewriteRule ^(login|register)/?$ /index.php [L,QSA]
RewriteCond %{QUERY_STRING} (^|&)mm_social_(session|return)=1(&|$) [NC]
RewriteRule ^$ /index.php [L,QSA]
RewriteRule ^$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^login/?$ /auth/login [R=301,L]
RewriteRule ^register/?$ /auth/register [R=301,L]
RewriteRule ^biblioteca/?$ / [R=301,L]
RewriteRule ^sube-tu-manga/?$ /contacto [R=301,L]
RewriteRule ^(perfil|saved|mas)/?$ /profile [R=301,L]
RewriteRule ^(manga-19|manga-bn|nosotros|contacto|legal|privacidad|terminos|normas-comunidad|cookies|comunidad|chat|tienda|pro|profile|transacciones|mensajes|notificaciones|recargar|pago-exitoso)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^(comunidad/publicacion/[^/]+|mensajes/[0-9]+|chat/[^/]+(/conversacion)?|perfil/editar|pro/pago|tienda/pago)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^recargar/pago/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^read/([0-9]+)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^auth/(login|register)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^usuarios/[0-9]+(/publicacion/[^/]+)?/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/wp-
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/feed
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/xmlrpc
RewriteRule ^ /index.php [L]
RewriteCond %{REQUEST_URI} ^/sitemap-react\.xml$
RewriteRule ^ /backend-patches/manga-sitemap-react.php [L]
RewriteRule ^sitemap-react-([0-9]+)\.xml$ /backend-patches/manga-sitemap-react.php?page=$1 [L]
RewriteRule ^sitemap-chapters\.xml$ /backend-patches/manga-sitemap-chapters.php [L]
RewriteRule ^sitemap-chapters-([0-9]+)\.xml$ /backend-patches/manga-sitemap-chapters.php?page=$1 [L]

RewriteCond %{REQUEST_URI} ^/sitemap
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} .*-sitemap\.xml$
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} \.xsl$
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/robots\.txt$
RewriteRule ^ /index.php [L]
RewriteRule ^manga/([0-9]+)/?$ /backend-patches/manga-social-meta.php?id=$1 [L,QSA]
RewriteCond %{REQUEST_URI} !^/(nosotros|contacto|perfil|saved|legal|catalog|pago-exitoso|manga-bn|manga-19|manga)/?$
RewriteRule ^([^/.]+)/?$ /backend-patches/manga-slug-redirect.php?slug=$1 [L,QSA]
RewriteRule ^ /backend-patches/manga-route-meta.php [L]
</IfModule>
