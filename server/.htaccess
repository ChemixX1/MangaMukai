DirectoryIndex index.html index.php

# Serve modern cover formats with their correct media type.
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
</IfModule>

# Keep the React shell fresh after deploys.
<IfModule mod_headers.c>
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
# Sin Clear-Site-Data: borraba la cache HTTP de todo el dominio en cada visita a
# la portada, obligando a redescargar JS, CSS y portadas en cada sesion (peor LCP
# y peor Page Experience). El shell ya viaja con no-store y los assets llevan
# hash en el nombre, asi que un deploy nuevo nunca se sirve cacheado.
</FilesMatch>
</IfModule>

# Country blocking is managed by manga-country-block.php.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# Keep OAuth callbacks and session cookies on one secure production origin.
# Leave ACME challenges reachable for automatic certificate renewals.
RewriteCond %{HTTP_HOST} ^(www\.)?mangamukai\.com(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mangamukai\.com [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://mangamukai.com%{REQUEST_URI} [R=301,L,NE]

# Never serve logs, backups or development leftovers from the web root.
# debug_auth.log used to expose live session tokens; the PHP that wrote it is gone,
# but the file and the .php.bak-* copies stay readable unless blocked here.
RewriteRule ^(src|node_modules|\.vscode)(/|$) - [F,L]
RewriteRule (^|/)(error_log|debug_auth\.log|\.env|package(-lock)?\.json|tsconfig[^/]*\.json|vite\.config\.ts)$ - [NC,F,L]
RewriteRule \.(log|bak|save|tmp|orig|sql)(\.|-|$) - [NC,F,L]
RewriteRule \.(php|js|css)\.(bak|before|codex)[^/]*$ - [NC,F,L]
RewriteRule (^|/)[^/]+\.before-[^/]*$ - [NC,F,L]
RewriteRule ^mangamukai-[^/]*\.zip$ - [NC,F,L]

# PayPal IPN callbacks must reach WordPress even though / serves React.
RewriteCond %{QUERY_STRING} (^|&)mm_(coin|sub)_ipn=1(&|$)
RewriteRule ^$ /index.php [L]

# Google/Discord OAuth starts and callbacks must reach WordPress, not the SPA.
RewriteCond %{QUERY_STRING} (^|&)(provider|return_provider)=(google|discord)(&|$) [NC]
RewriteRule ^(login|register)/?$ /index.php [L,QSA]

# Exchange the OAuth result or an authenticated WordPress cookie for React.
RewriteCond %{QUERY_STRING} (^|&)mm_social_(session|return)=1(&|$) [NC]
RewriteRule ^$ /index.php [L,QSA]

# Cada ruta de React recibe su propio head SEO (title, description, canonical,
# JSON-LD y contenido en noscript). Sin esto todas las rutas comparten el head
# estatico de index.html, que declara canonical hacia la portada.
RewriteRule ^$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^(biblioteca|manga-19|manga-bn|nosotros|contacto|legal|perfil|saved|recargar|pago-exitoso)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^read/([0-9]+)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^auth/(login|register)/?$ /backend-patches/manga-route-meta.php [L,QSA]
RewriteRule ^usuarios/([0-9]+)/?$ /backend-patches/manga-route-meta.php [L,QSA]

# Serve real files and directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# WordPress routes.
RewriteCond %{REQUEST_URI} ^/wp-
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/feed
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/xmlrpc
RewriteRule ^ /index.php [L]

# Sitemaps and robots.
RewriteCond %{REQUEST_URI} ^/sitemap-react\.xml$
RewriteRule ^ /backend-patches/manga-sitemap-react.php [L]

# Indice y bloques del sitemap de capitulos (/read/{id}).
RewriteRule ^sitemap-chapters\.xml$ /backend-patches/manga-sitemap-chapters.php [L]
RewriteRule ^sitemap-chapters-([0-9]+)\.xml$ /backend-patches/manga-sitemap-chapters.php?page=$1 [L]

RewriteCond %{REQUEST_URI} ^/sitemap
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} .*-sitemap\.xml$
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} \.xsl$
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_URI} ^/robots\.txt$
RewriteRule ^ /index.php [L]

# Every manga request receives a server-rendered SEO head and the normal SPA.
RewriteRule ^manga/([0-9]+)/?$ /backend-patches/manga-social-meta.php?id=$1 [L,QSA]

# Consolidate old WordPress manga slugs into the canonical /manga/{id} route.
# Known one-segment React routes bypass the WordPress lookup.
RewriteCond %{REQUEST_URI} !^/(nosotros|contacto|perfil|saved|legal|catalog|pago-exitoso|manga-bn|manga-19|manga)/?$
RewriteRule ^([^/.]+)/?$ /backend-patches/manga-slug-redirect.php?slug=$1 [L,QSA]

# Everything else goes to the React SPA.
RewriteRule ^ /index.html [L]
</IfModule>
