# URL del WordPress que contiene la API y los endpoints de MangaMukai.
VITE_WORDPRESS_URL=https://mangamukai.com

# Valores del atributo content, no pegues la etiqueta HTML completa.
# Search Console: propiedad de prefijo URL; para propiedad de dominio usa DNS TXT.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# URL de las imágenes QR reales de cada billetera. Si está vacío se muestra su marca.
VITE_YAPE_QR_URL=
VITE_PLIN_QR_URL=
